# PostgreSQL — requis seulement quand les comptes seront branchés.
DATABASE_URL="postgresql://velyon:velyon@localhost:5432/velyon?schema=public"

# URL publique utilisée par le moteur PDF pour ouvrir l'aperçu.
# En local, laisser vide : l'origine de la requête est utilisée.
APP_URL=""

# Fournisseur de rédaction. Valeurs : gemini, mistral, anthropic.
# Sans clé, le dossier est quand même produit à partir de la grille.
AI_PROVIDER=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Secrets serveur — ne jamais préfixer par NEXT_PUBLIC_.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Stockage S3 compatible (logos et polices), étape import.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"
